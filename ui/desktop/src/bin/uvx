#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME_SHIM_PATH="${BASH_SOURCE[0]}"
source "${SCRIPT_DIR}/node-setup-common.sh"

if [ -n "${OBELUS_UV_REGISTRY:-}" ]; then
    export UV_INDEX_URL="${OBELUS_UV_REGISTRY}"
    runtime_log "Using the explicitly configured Python package registry."
elif [ -n "${GOOSE_UV_REGISTRY:-}" ]; then
    export UV_INDEX_URL="${GOOSE_UV_REGISTRY}"
    runtime_log "GOOSE_UV_REGISTRY is a compatibility alias; prefer OBELUS_UV_REGISTRY."
    runtime_log "Using the explicitly configured Python package registry."
fi

UVX_BINARY="$(runtime_resolve_binary uvx OBELUS_UVX_BINARY GOOSE_UVX_BINARY OBELUS_UVX_SHIM_ACTIVE)"
runtime_exec uvx "${UVX_BINARY}" OBELUS_UVX_SHIM_ACTIVE "$@"
