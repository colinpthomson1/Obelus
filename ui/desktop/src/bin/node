#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME_SHIM_PATH="${BASH_SOURCE[0]}"
source "${SCRIPT_DIR}/node-setup-common.sh"

runtime_configure_node_environment
NODE_BINARY="$(runtime_resolve_binary node OBELUS_NODE_BINARY GOOSE_NODE_BINARY OBELUS_NODE_SHIM_ACTIVE)"
runtime_exec node "${NODE_BINARY}" OBELUS_NODE_SHIM_ACTIVE "$@"
