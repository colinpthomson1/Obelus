#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME_SHIM_PATH="${BASH_SOURCE[0]}"
source "${SCRIPT_DIR}/node-setup-common.sh"

runtime_configure_node_environment
NPX_BINARY="$(runtime_resolve_binary npx OBELUS_NPX_BINARY GOOSE_NPX_BINARY OBELUS_NPX_SHIM_ACTIVE)"
runtime_exec npx "${NPX_BINARY}" OBELUS_NPX_SHIM_ACTIVE "$@"
