#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME_SHIM_PATH="${BASH_SOURCE[0]}"
source "${SCRIPT_DIR}/node-setup-common.sh"

if [ -n "${OBELUS_JBANG_REGISTRY:-}" ]; then
    export JBANG_REPO="${OBELUS_JBANG_REGISTRY}"
    runtime_log "Using the explicitly configured JBang registry."
elif [ -n "${GOOSE_JBANG_REGISTRY:-}" ]; then
    export JBANG_REPO="${GOOSE_JBANG_REGISTRY}"
    runtime_log "GOOSE_JBANG_REGISTRY is a compatibility alias; prefer OBELUS_JBANG_REGISTRY."
    runtime_log "Using the explicitly configured JBang registry."
fi

runtime_log "JBang trust remains user-managed; Obelus does not add wildcard trust entries."
JBANG_BINARY="$(runtime_resolve_binary jbang OBELUS_JBANG_BINARY GOOSE_JBANG_BINARY OBELUS_JBANG_SHIM_ACTIVE)"
runtime_exec jbang "${JBANG_BINARY}" OBELUS_JBANG_SHIM_ACTIVE "$@"
